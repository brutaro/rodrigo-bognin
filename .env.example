TRIA_DEMO_WRITES=disabled

# Docker local. Copie para .env e informe caminhos somente na cópia ignorada.
TRIA_PORT=3100
# Forwarded headers ficam desativados no Compose local. Não habilite sem proxy que remova cabeçalhos do cliente.
TRIA_TRUST_PROXY=disabled
TRIA_SOURCE_ACTIVITIES=/caminho/local/activities.csv
TRIA_SOURCE_NOTES=/caminho/local/notes.csv
TRIA_SOURCE_RELATIONS=/caminho/local/relations.csv
TRIA_SOURCE_EVIDENCE=/caminho/local/evidence.csv

# O Docker Compose lê estes valores somente de arquivos ignorados em .secrets/:
# tria_login_code, tria_session_key e file_store_uuid.
# O cofre usa quota fixa de 9.000.000.000 bytes; não há variável para elevá-la.
